# Folder that holds notiz.db (SQLite) and attachments/. Relative paths resolve from the repo root.
DATA_DIR=./data
# Port of the API server (not PORT, which dev launchers set for the web server). The web dev server proxies /api to it.
API_PORT=3001
# Opt-in: address the web dev server listens on, so other devices can open Notiz.
# Notiz has no login: use a private address such as your Tailscale IP (100.x.y.z), never a public network.
# WEB_HOST=100.x.y.z
